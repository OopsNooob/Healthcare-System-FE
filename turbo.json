{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["EXPO_PUBLIC_API_URL", "VITE_API_BASE_URL", "VITE_MOCK_AUTH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
